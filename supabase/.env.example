# ═══════════════════════════════════════════════════════════════════════════════
# ATHANOR — EDGE FUNCTION SECRETS   ·   Stripe sandbox acct_1U23HsQ27ZDmslJ8 (DE/EUR)
#
#   cp supabase/.env.example supabase/.env      # .env is gitignored — never commit it
#   supabase secrets set --env-file ./supabase/.env --project-ref kwzeiqvrnnaagccyoose
#
# SERVER ONLY. Nothing here may ever appear in apps/ or packages/ — the mobile app holds
# no Stripe key of any kind, because every payment opens a hosted Stripe URL minted by an
# edge function. Client values live in apps/native/.env.example.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Secret key for the sandbox. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=sk_test_replace_me

# Signing secret of the webhook endpoint below. Dashboard → Developers → Webhooks →
# we_1U257CQ27ZDmslJ8unxgUdUC → "Signing secret" → Reveal.
# NOTE the name: the code reads STRIPE_WEBHOOK_SECRET (stripe-webhook/index.ts:8),
# not STRIPE_WEBHOOK_SIGNING_SECRET.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Athanor Circle recurring prices (product prod_V29QBE8aw9OdcL). Already created —
# these are the real sandbox ids, not placeholders. €12/month and €99/year, matching
# the shipped i18n copy in packages/i18n/src/catalogs/{it,en}.json:995-996.
STRIPE_PRICE_CIRCLE_MONTHLY=price_1U257TQ27ZDmslJ8PSARPoTh
STRIPE_PRICE_CIRCLE_ANNUAL=price_1U257aQ27ZDmslJ8VowSaJYW

# There is deliberately NO STRIPE_API_VERSION here. The version is a code constant,
# supabase/functions/_shared/stripe.ts:10 = '2026-05-27.dahlia', and the webhook endpoint
# must be created at that same version. Splitting it across code and env is how the two
# drift apart and payload shapes stop matching.

# ─── App ───────────────────────────────────────────────────────────────────────
# Base for every Stripe return/success/cancel deeplink. Must match app.json "scheme".
APP_DEEPLINK_BASE=athanor://

# HMAC key for event-ticket QR tokens (_shared/qr.ts). Any long random string; rotating
# it invalidates every unscanned ticket, so treat it as permanent once events are live.
#   openssl rand -base64 48
QR_SIGNING_SECRET=replace_me

# Expo push access token — push-dispatch sends through Expo's service.
# expo.dev → Account settings → Access tokens.
EXPO_ACCESS_TOKEN=replace_me

# ─── Do NOT set anything prefixed SUPABASE_ ────────────────────────────────────
# The prefix is reserved and `supabase secrets set` will reject it. The platform injects,
# automatically, into every deployed function:
#   SUPABASE_URL · SUPABASE_DB_URL · SUPABASE_JWKS
#   SUPABASE_PUBLISHABLE_KEYS · SUPABASE_SECRET_KEYS   ← name-keyed JSON, not plain strings
#   SUPABASE_ANON_KEY · SUPABASE_SERVICE_ROLE_KEY      ← legacy, deprecated end-2026
# Functions must read these only through _shared/keys.ts (publishableKey/secretKey/secretKeys),
# never Deno.env.get directly — the new ones are JSON dictionaries and the legacy ones die
# the moment legacy keys are disabled.
#
# For `supabase functions serve` locally, use the values `supabase status` prints; the local
# stack issues its own sb_publishable_/sb_secret_ pair. Keep them in supabase/.env.local,
# which is separately gitignored.

# ─── Reference — public identifiers, not secrets ───────────────────────────────
# SUPABASE_PROJECT_REF=kwzeiqvrnnaagccyoose            # public: in every API URL
# STRIPE_ACCOUNT_ID=acct_1U23HsQ27ZDmslJ8
# STRIPE_WEBHOOK_DESTINATION=we_1U257CQ27ZDmslJ8unxgUdUC   # 2026-05-27.dahlia, 10 events
#                                                          # NOT the two async_payment_* ones:
#                                                          # delayed settlement is unsupported
#                                                          # and processEvent throws on them.
# STRIPE_WEBHOOK_DESTINATION_OLD=we_1U23QwQ27ZDmslJ8EqF5ZvjO  # 2020-08-27, 3 PaymentIntent
#                                                             # events the code never handled.
#                                                             # Disable once the new one is live.
# STRIPE_PAYMENT_METHOD_CONFIG=pmc_1U23I2Q27ZDmslJ8WsNgBSei   # immediate-notification methods
#   ONLY (card + wallets, Link, PayPal, Bancontact, EPS …). No code pins payment_method_types,
#   so this configuration is the sole control over which rails reach Checkout. Enabling a
#   delayed rail here (SEPA, ACH, Bacs, BECS, ACSS, Pay by Bank, BLIK, vouchers, bank
#   transfers) makes stripe-webhook 500 by design — see assertSettled in
#   functions/stripe-webhook/handlers.ts. Never ask Stripe Support to enable asynchronous
#   payment methods on PayPal: it is synchronous by default, which is why PayPal is safe here.
# STRIPE_CIRCLE_PRODUCT=prod_V29QBE8aw9OdcL
#
# Postgres GUCs are NOT set here — they are operator commands against the database
# (`alter database postgres set "app.settings.*"`). A secret in a migration would be
# committed to git and, under rule #7, unrotatable. See docs/PRODUCTION-READINESS.md.
