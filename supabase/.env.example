# ATHANOR — edge function secrets. SERVER ONLY: nothing here may ever appear in apps/
# or packages/. Client values live in apps/{native,web}/.env.example.
#   cp supabase/.env.example supabase/.env      # .env is gitignored — never commit it
#   supabase secrets set --env-file ./supabase/.env --project-ref kwzeiqvrnnaagccyoose

# ─── Stripe (sandbox acct_1U23HsQ27ZDmslJ8, DE/EUR — ids in supabase/ENV-NOTES.md) ───
# Secret key: Dashboard → Developers → API keys.
STRIPE_SECRET_KEY=

# Signing secret of the webhook destination (Dashboard → Webhooks → Reveal). NOTE the
# name: the code reads STRIPE_WEBHOOK_SECRET, not STRIPE_WEBHOOK_SIGNING_SECRET.
STRIPE_WEBHOOK_SECRET=

# Circle recurring prices — real sandbox ids, not placeholders (€12/month, €99/year).
STRIPE_PRICE_CIRCLE_MONTHLY=price_1U257TQ27ZDmslJ8PSARPoTh
STRIPE_PRICE_CIRCLE_ANNUAL=price_1U257aQ27ZDmslJ8VowSaJYW

# Deliberately NO STRIPE_API_VERSION here — it is a code constant
# (functions/_shared/stripe.ts) and the webhook endpoint must match it. See ENV-NOTES.md.

# ─── App ─────────────────────────────────────────────────────────────────────────────
# Base for Checkout success/cancel deeplinks (circle, tickets, contributions, portal).
# Must match app.json "scheme". Checkout is the only Stripe product that accepts a custom
# scheme — Identity and Account Links validate for http(s), hence the three vars below.
APP_DEEPLINK_BASE=athanor://

# ─── Stripe https return URLs (#418) ─────────────────────────────────────────────────
# These point at apps/web's `/app/*` hand-off pages, which forward to `athanor://`. They
# are NOT interchangeable with APP_DEEPLINK_BASE: widening that one to https would send
# the four Checkout flows through the web too, and their `athanor://` URLs are what
# WebBrowser.openAuthSessionAsync matches on to close the sheet.
#
# Set these only once apps/web is deployed with the routes — apps/web reaches production
# at a dev → main release, and a URL set ahead of that redirects members to a 404.
#
# Identity `return_url`. A BASE, with the trailing slash: the function appends
# `verify?status=complete`. Unset → the param is omitted and verification behaves as it
# did before #418 (the flip comes from webhook W9, never from the redirect).
IDENTITY_RETURN_BASE=https://www.athanor.workers.dev/app/

# Account Links return/refresh for create-payout-onboarding. Full URLs, not bases.
# Unset → the function answers `500 payout onboarding not configured` before any Stripe
# call, so an unconfigured project can never orphan a Connect account.
PAYOUT_ONBOARDING_RETURN_URL=https://www.athanor.workers.dev/app/payout/return
PAYOUT_ONBOARDING_REFRESH_URL=https://www.athanor.workers.dev/app/payout/refresh

# HMAC key for event-ticket QR tokens (_shared/qr.ts) — `openssl rand -base64 48`.
# Rotating invalidates every unscanned ticket: permanent once events are live.
QR_SIGNING_SECRET=

# Expo push access token — expo.dev → Account settings → Access tokens.
EXPO_ACCESS_TOKEN=

# ─── Do NOT set anything prefixed SUPABASE_ ──────────────────────────────────────────
# The prefix is reserved; the platform injects those vars into every deployed function.
# Read them only via functions/_shared/keys.ts. Details: supabase/ENV-NOTES.md.
