# Playwright web smoke (e2e) — local secrets, copy to .env.test (gitignored).
#
# The smoke drives the real /auth/confirm route with an admin-minted magic-link
# token, so it needs the local-stack service-role key. Get it from:
#   supabase status            (SERVICE_ROLE_KEY)
# NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY come from .env.local — no need to repeat them.
#
# Never commit .env.test. Service-role key is local-stack only.

SUPABASE_SERVICE_ROLE_KEY=replace-with-SERVICE_ROLE_KEY-from-supabase-status
