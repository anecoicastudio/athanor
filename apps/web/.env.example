# Canonical site origin (metadataBase, robots, sitemap). Must stay in lockstep with the
# deep-link host in AASA/assetlinks + apps/native/app.json. Switch when the custom domain lands.
NEXT_PUBLIC_SITE_URL=https://athanor-page.vercel.app

# Public @handle SSR reads the hosted Supabase (read-only, RLS-gated).
NEXT_PUBLIC_SUPABASE_URL=

# Preferred: the new-style publishable key (`sb_publishable_…`, Settings → API Keys).
# Leave empty until you have the real value — a non-blank string wins over the anon
# fallback and turns into opaque 401s.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT — fallback only; dies when legacy API keys are disabled (end-2026).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pre-launch waitlist (apps/web/app/api/waitlist). Server-only — never NEXT_PUBLIC.
# Without RESEND_API_KEY the signup is still stored; only the email notification is skipped.
RESEND_API_KEY=
WAITLIST_TO=athanor@gmail.com
