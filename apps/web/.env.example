# Canonical site origin (metadataBase, robots, sitemap). Must stay in lockstep with the
# deep-link host in AASA/assetlinks + apps/native/app.json (`lib/site.test.ts` asserts it).
NEXT_PUBLIC_SITE_URL=https://www.athanor.world

# Public @handle SSR reads the hosted Supabase (read-only, RLS-gated).
NEXT_PUBLIC_SUPABASE_URL=

# Preferred: the new-style publishable key (`sb_publishable_…`, Settings → API Keys).
# Leave empty until you have the real value — a non-blank string wins over the anon
# fallback and turns into opaque 401s.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT — fallback only; dies when legacy API keys are disabled (end-2026).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The waitlist route needs no env of its own. RESEND_API_KEY / WAITLIST_TO are GONE (issue
# #23): it used to email the operator per signup, which meant a script with a fresh address
# each time mailbombed the inbox and burned the quota. Read signups at /admin/waitlist.

# Cloudflare Web Analytics beacon token (Dashboard → Analytics → Web Analytics).
# Optional: absent means no beacon, which is what local dev wants. Cloudflare cannot
# auto-inject it for a Worker (custom domain or *.workers.dev), so app/layout.tsx mounts it by hand.
NEXT_PUBLIC_CF_BEACON_TOKEN=
