# Public @handle SSR reads the hosted Supabase (read-only, RLS-gated).
NEXT_PUBLIC_SUPABASE_URL=

# Preferred: the new-style publishable key (Settings → API Keys). Replaces the legacy
# anon JWT, which Supabase deprecates by the end of 2026.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Legacy — still accepted as a fallback; dies the moment "Disable legacy API keys" is
# clicked or the old HS256 secret is revoked. Remove once the publishable key is live.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Pre-launch waitlist (apps/web/app/api/waitlist). Server-only — never NEXT_PUBLIC.
# Without RESEND_API_KEY the signup is still stored; only the email notification is skipped.
RESEND_API_KEY=
WAITLIST_TO=athanor@gmail.com
