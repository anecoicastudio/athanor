# Athanor mobile env — PUBLIC values only. Never a service key (Foundation §2 / R-1).
# Only EXPO_PUBLIC_* is bundled into the app; anything else is ignored by Expo.
# Copy to `.env` and fill in.

# --- HOSTED Supabase (kwzeiqvrnnaagccyoose, eu-central-1) — default for dev/preview ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-hosted-anon-key

# --- LOCAL Supabase (`supabase start` prints these) — uncomment to switch ---
# Use the Mac's LAN IP (not 127.0.0.1) so a physical device on the same Wi-Fi can reach it.
# EXPO_PUBLIC_SUPABASE_URL=http://<mac-lan-ip>:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-start

# --- Sentry crash reporting (P1.4) ---
# DSN is public by design (ships in the bundle). Consent-gated + PII-scrubbed at runtime.
# No-op in Expo Go (native module absent) and when unset. Leave blank to disable.
# The server-only SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT (source-map upload)
# go in EAS build secrets — NEVER here.
EXPO_PUBLIC_SENTRY_DSN=https://<key>@<org-id>.ingest.<region>.sentry.io/<project-id>
