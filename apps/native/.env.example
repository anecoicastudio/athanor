# Athanor mobile env — PUBLIC values only (EXPO_PUBLIC_*); never a service or sb_secret_
# key (Foundation §2 / R-1). Copy to `.env` and fill in.
# ⚠ EAS cloud builds do NOT read this file — every var must also exist as an EAS
# environment variable for the profile's environment in eas.json, or the build boots
# into "Missing Supabase API key".

# --- HOSTED Supabase (eu-central-1) ---
# Deliberately blank. The ref is not a secret — it ships in every API call — but this
# file gets copied to `.env`, and a pre-filled ref is a pre-filled ref to PRODUCTION:
# a local dev build then writes real rows and burns real quota with nothing to warn
# you. Paste the ref for the project you actually mean (staging for day-to-day work).
EXPO_PUBLIC_SUPABASE_URL=

# Preferred: the new-style publishable key (`sb_publishable_…`, Settings → API Keys).
# Leave empty until you have the real value — a non-blank string wins over the fallback.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon JWT — fallback only; dies when legacy API keys are disabled (end-2026).
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- LOCAL Supabase (`supabase start` prints these) — uncomment to switch ---
# Use the Mac's LAN IP (not 127.0.0.1) so a physical device on the same Wi-Fi reaches it.
# EXPO_PUBLIC_SUPABASE_URL=http://<mac-lan-ip>:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Mapbox city search (#149) ---
# PUBLIC token (pk.…, publishable-grade — never a secret sk. token). Powers the
# typed-text city picker in Profilo; only the typed query ever leaves the device.
# Leave empty to degrade the picker to free text (city stores no geohash then).
EXPO_PUBLIC_MAPBOX_TOKEN=

# --- Site origin (#486) ---
# The host this build hands out links on (invite, profile, terms, privacy) AND the host it
# claims as a universal link / App Link: app.config.ts rewrites app.json's associatedDomains
# and android.intentFilters from this same value, so the two can never drift. Must be an
# https origin with no trailing slash; a malformed value fails the build at config time.
# Leave empty for production (https://www.athanor.workers.dev) — app.json is the default of
# record. There is no staging web host to point at yet (#471); when there is, this becomes one
# `eas env:create` per profile and nothing else.
EXPO_PUBLIC_SITE_ORIGIN=

# --- Sentry crash reporting (P1.4) ---
# DSN is public by design (ships in the bundle); consent-gated + PII-scrubbed at runtime.
# Leave empty to disable. Server-only SENTRY_AUTH_TOKEN/ORG/PROJECT go in EAS build
# secrets — never here.
EXPO_PUBLIC_SENTRY_DSN=

# No Stripe or payment variable belongs in this app — payments open hosted Stripe URLs
# minted by edge functions. The full list of deliberately-absent vars and why:
# supabase/ENV-NOTES.md.
