# Athanor mobile env — PUBLIC values only. Never a service key, never sb_secret_
# (Foundation §2 / R-1). Only EXPO_PUBLIC_* is bundled into the app; anything else is
# ignored by Expo. Copy to `.env` and fill in.
#
# ⚠ EAS CLOUD BUILDS DO NOT READ THIS FILE — `.env` is gitignored and never uploaded.
# Every EXPO_PUBLIC_* below must also exist as an EAS environment variable (plaintext
# visibility — these ship inside the bundle anyway) for the environment named on the
# build profile in eas.json. A missing one is a build that boots straight into
# "Missing Supabase API key", not a build-time error.

# --- HOSTED Supabase (eu-central-1) — default for dev/preview ---
# The project ref is public: it appears in every API call and in the URL below.
EXPO_PUBLIC_SUPABASE_URL=https://kwzeiqvrnnaagccyoose.supabase.co

# Preferred: the new-style publishable key (Settings → API Keys). Replaces the legacy
# anon JWT, which Supabase deprecates by the end of 2026.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Legacy — still accepted as a fallback, but the project's JWT signing key is already
# asymmetric (ES256) with the old HS256 secret only on standby. Revoking that secret, or
# clicking "Disable legacy API keys", kills this key. Remove this line once no build in
# the wild still depends on it.
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-hosted-anon-key

# --- LOCAL Supabase (`supabase start` prints these) — uncomment to switch ---
# Use the Mac's LAN IP (not 127.0.0.1) so a physical device on the same Wi-Fi can reach it.
# Newer CLI versions print a publishable key alongside the anon key; prefer it.
# EXPO_PUBLIC_SUPABASE_URL=http://<mac-lan-ip>:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key-from-supabase-start
# EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-start

# --- Sentry crash reporting (P1.4) ---
# DSN is public by design (ships in the bundle). Consent-gated + PII-scrubbed at runtime.
# No-op in Expo Go (native module absent) and when unset. Leave blank to disable.
# The server-only SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT (source-map upload)
# go in EAS build secrets — NEVER here.
EXPO_PUBLIC_SENTRY_DSN=https://<key>@<org-id>.ingest.<region>.sentry.io/<project-id>

# --- No Stripe key belongs here. Server values live in supabase/.env.example ---
# Every payment flow opens hosted Stripe Checkout from an edge function
# (create-ticket-checkout / -contribution-session / -circle-checkout / -circle-portal /
# -verification-session). The app never holds a Stripe key, publishable or otherwise, and
# @stripe/stripe-react-native is deliberately NOT a dependency: it is a native module and
# would break App Store Expo Go.
#
# So none of these exist in this app, and adding them would be dead weight — nothing reads
# them, and Metro would inline them into the shipped bundle:
#   EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY   no client SDK to hand it to
#   EXPO_PUBLIC_STRIPE_RETURN_URL        return urls are built server-side from
#                                        APP_DEEPLINK_BASE, so they cannot drift
#   EXPO_PUBLIC_APP_SCHEME               already declared once, in app.json "scheme"
#   EXPO_PUBLIC_APPLE_MERCHANT_ID        Apple Pay needs the native SDK
#   EXPO_PUBLIC_GOOGLE_PAY_TEST_ENV      same
#   EXPO_PUBLIC_MERCHANT_COUNTRY         Checkout takes this from the Stripe account (DE)
#   EXPO_PUBLIC_DEFAULT_CURRENCY         priced server-side per session; 'eur' throughout
#
# Reference (public identifiers, not secrets):
#   SUPABASE_PROJECT_REF   kwzeiqvrnnaagccyoose
#   STRIPE_ACCOUNT_ID      acct_1U23HsQ27ZDmslJ8   (sandbox, DE / EUR)
