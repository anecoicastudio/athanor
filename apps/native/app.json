{
  "expo": {
    "name": "Athanor",
    "slug": "athanor",
    "owner": "anecoica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "athanor",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a1a",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9eb6e3f0-ef63-4467-896e-16136b6fd68f"
    },
    "ios": {
      "bundleIdentifier": "world.athanor.app",
      "associatedDomains": ["applinks:www.athanor.world"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "world.athanor.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "www.athanor.world",
              "pathPrefix": "/momento"
            },
            {
              "scheme": "https",
              "host": "www.athanor.world",
              "pathPrefix": "/event"
            },
            {
              "scheme": "https",
              "host": "www.athanor.world",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "www.athanor.world",
              "pathPrefix": "/dream"
            },
            {
              "scheme": "https",
              "host": "www.athanor.world",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "www.athanor.world",
              "pathPrefix": "/@"
            }
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a1a",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Athanor accesses your photos only when you choose one to share — never your whole library.",
          "cameraPermission": "Athanor uses the camera so you can capture a photo or video for a moment or a post."
        }
      ],
      "expo-video",
      "expo-camera",
      [
        "expo-audio",
        {
          "microphonePermission": "Athanor uses the microphone when you record a voice note, or a video for a moment or a post.",
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Athanor uses your approximate location to show events near you and to place an event you create — never in the background."
        }
      ],
      "./plugins/without-location-task-service.js",
      [
        "expo-calendar",
        {
          "calendarPermission": "Athanor adds events you're attending to your calendar — only when you choose."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#2BD0D2",
          "defaultChannel": "default"
        }
      ],
      "@sentry/react-native/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9eb6e3f0-ef63-4467-896e-16136b6fd68f"
      }
    }
  }
}
