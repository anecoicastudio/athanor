{
  "expo": {
    "name": "Athanor",
    "slug": "athanor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "athanor",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a1a",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a1a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0a1a",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Athanor accesses your photos only when you choose one to share — never your whole library.",
          "cameraPermission": "Athanor uses the camera so you can capture a photo or video for a moment or a post.",
          "microphonePermission": "Athanor uses the microphone when you record a video for a moment or a post."
        }
      ],
      "expo-video",
      "expo-audio",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Athanor uses your approximate location only to show events near you — never in the background."
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Athanor adds events you're attending to your calendar — only when you choose."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
