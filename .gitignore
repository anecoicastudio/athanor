# deps
node_modules/

# builds
.expo/
dist/
.turbo/
.next/
out/
*.tsbuildinfo
test-results/
playwright-report/

# env — examples only
.env
.env.*
!.env.example

# supabase local
supabase/.temp/
supabase/.branches/

# misc
.DS_Store
*.log
coverage/

# mutation testing (Stryker) — .stryker-tmp is a sandbox copy of the whole package,
# node_modules included, so it must never be committed or scanned.
# `**/` is required on the second one: a pattern with an interior slash is anchored to this
# file's directory, so a bare `reports/mutation/` would only match one at the repo root.
.stryker-tmp/
**/reports/mutation/

# internal docs & agent tooling — kept out of this repo.
# Five exceptions: tracked source files cite four of these ~100 times by section
# number (`RELEASE-RUNBOOK §6`, `PRD §4.11`, `DESIGN.md`, `PRODUCTION-READINESS P5`),
# so leaving them untracked leaves every collaborator with pointers to files they
# cannot open; ARCHITECTURE.md is the partner-facing system overview. Anything
# added here must be readable by someone outside the repo's owner — the rest of
# /docs/ is not.
#
# `/docs/*`, not `/docs/` — git never descends into an ignored *directory*, so a
# negation inside one is never evaluated. Matching the contents keeps the four
# re-includes live while still ignoring every subdirectory.
/docs/*
!/docs/RELEASE-RUNBOOK.md
!/docs/DESIGN.md
!/docs/PRD.md
!/docs/PRODUCTION-READINESS.md
!/docs/ARCHITECTURE.md
.claude/
CLAUDE.md
*.types.ts.tmp
.gstack/
# Deno edge-function local lockfile (transient; functions pin deps in deno.json)
deno.lock

# pnpm is the package manager (node-linker=hoisted). A stray npm/yarn lockfile is not
# just noise: EAS Build infers the package manager from the lockfile it finds, so one of
# these at the root can make a cloud build install with the wrong tool.
/package-lock.json
/yarn.lock

# superpowers local
.superpowers/

# local scratch notes (never committed)
.scratch/

# Cloudflare Workers build output + local secrets (apps/web)
.open-next/
.wrangler/
.dev.vars*
apps/web/cloudflare-env.d.ts

# `/index` skill output — a generated map of the tree, regenerated on demand and
# stale the moment it is not. Never a review artifact.
/PROJECT_INDEX.json
