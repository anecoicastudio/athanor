# deps
node_modules/

# builds
.expo/
dist/
.turbo/
.next/
out/
.vercel
*.tsbuildinfo
test-results/
playwright-report/

# env — examples only
.env
.env.*
!.env.example
!.env.test.example

# supabase local
supabase/.temp/
supabase/.branches/

# misc
.DS_Store
*.log
coverage/

# mutation testing (Stryker) — .stryker-tmp is a sandbox copy of the whole package,
# node_modules included, so it must never be committed or scanned.
# `**/` is required on the second one: a pattern with an interior slash is anchored to this
# file's directory, so a bare `reports/mutation/` would only match one at the repo root.
.stryker-tmp/
**/reports/mutation/

# internal docs & agent tooling — kept out of this repo
/docs/
.claude/
CLAUDE.md
AGENTS.md
*.types.ts.tmp
.gstack/
# Deno edge-function local lockfile (transient; functions pin deps in deno.json)
deno.lock

# superpowers local
.superpowers/

# local scratch notes (never committed)
.scratch/
